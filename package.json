{
  "name": "peer",
  "version": "0.1.0",
  "description": "Cross-repo GitHub code-review bot (V1) — reviews pull requests with context from other repositories in the org, powered by Claude Code",
  "private": true,
  "type": "module",
  "bin": {
    "peer": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.227",
    "@octokit/auth-app": "^8.3.0",
    "better-sqlite3": "12.9.0",
    "commander": "^12.0.0",
    "dotenv": "^17.4.2",
    "execa": "^9.0.0",
    "octokit": "^5.0.5",
    "pino": "^9.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  }
}
