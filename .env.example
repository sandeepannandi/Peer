# ── GitHub App (required for live review / mirror) ─────────────────────────
# Register a GitHub App on your org, generate a private key, and set:
GITHUB_APP_ID=
# Either the path to the private key .pem file…
GITHUB_PRIVATE_KEY_PATH=
# …or the key contents as base64 (set exactly one of the two):
# GITHUB_PRIVATE_KEY=

# Org whose repositories are mirrored (defaults to the PR's owner when reviewing)
GITHUB_ORG=

# ── Webhook (bot mode) ───────────────────────────────────────────────────────
# Secret used to verify X-Hub-Signature-256 on incoming webhooks.
GITHUB_WEBHOOK_SECRET=
# Port the `peer webhook` listener binds to.
WEBHOOK_PORT=3000

# ── Claude Code (subscription auth via `claude login`) ─────────────────────
# NOTE: never set ANTHROPIC_API_KEY — Peer must run through Claude Code.
CLAUDE_MODEL=sonnet
CLAUDE_MAX_TURNS=30

# ── Context pack ─────────────────────────────────────────────────────────────
REVIEW_MAX_CONTEXT_FILES=12
CONTEXT_TOKEN_BUDGET=40000

# ── Posting ──────────────────────────────────────────────────────────────────
MAX_REVIEW_COMMENTS=20

# ── Paths / logging ──────────────────────────────────────────────────────────
DATA_DIR=./data
LOG_LEVEL=info
